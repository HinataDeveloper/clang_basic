$(BIN_DIR)	Makefile	/^$(BIN_DIR):$/;"	t
$(BIN_DIR)/%	Makefile	/^$(BIN_DIR)\/%: $(SRC_DIR)\/%.c | $(BIN_DIR)$/;"	t
BINS	Makefile	/^BINS := $(patsubst $(SRC_DIR)\/%.c,$(BIN_DIR)\/%,$(SRCS))$/;"	m
BIN_DIR	Makefile	/^BIN_DIR := bin$/;"	m
CC	Makefile	/^CC      := gcc$/;"	m
CFLAGS	Makefile	/^CFLAGS  := -Wall -Wextra -g -fsanitize=address,undefined$/;"	m
NAME	Makefile	/^NAME    ?= main$/;"	m
SRCS	Makefile	/^SRCS := $(wildcard $(SRC_DIR)\/*.c)$/;"	m
SRC_DIR	Makefile	/^SRC_DIR := src$/;"	m
all	Makefile	/^all: $(BINS)$/;"	t
clean	Makefile	/^clean:$/;"	t
main	snapshots/src_2026-10-22_05-10-39/main.c	/^int main(void)$/;"	f	typeref:typename:int
